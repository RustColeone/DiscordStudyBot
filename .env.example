# Required. Enter the token directly on the server; never commit it.
TOKEN=

# Optional Discord IDs used by clock, broadcast, and music features.
ID_CHANNEL=
ID_CHANNEL1=
ID_MESSAGE=
ID_VOICECHANNEL=
DISCORD_ALLOWED_CHANNELS=
DISCORD_REQUIRE_MENTION=false
CREATOR_USER_ID=
CREATOR_ONLY_MODE=false
CREATOR_PROMPT=
TIMEZONE=America/Los_Angeles

# Optional integrations. Leave unset to keep those features disabled.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
CLAUDE_API_KEY=
SERP_API_KEY=
WOLFRAM_APPID=
WOLFRAM_PATH=

# Optional server-admin overrides for collaborative agent mode.
AGENT_LUNA_MODEL=gpt-5.6-luna
AGENT_GEMINI_MODEL=gemini-3.5-flash-lite
AGENT_CLAUDE_MODEL=claude-haiku-4-5-20251001
AGENT_GEMINI_MIN_INTERVAL_SECONDS=1.1

# DeepSeek phase effort: low, medium, or high.
AGENT_OPENING_EFFORT=high
AGENT_PLANNING_EFFORT=high

# Independent room discussion/consultation effort: low, medium, or high.
AGENT_DEEPSEEK_EFFORT=high
AGENT_LUNA_EFFORT=high
AGENT_GEMINI_EFFORT=high
AGENT_CLAUDE_EFFORT=high

ATTACHMENT_CACHE_DIR=temp/attachment_cache
AGENT_DEEPSEEK_PROMPT=
AGENT_LUNA_PROMPT=
AGENT_GEMINI_PROMPT=
AGENT_CLAUDE_PROMPT=