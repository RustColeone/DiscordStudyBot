# Copy to .env (git-ignored) and fill in what you use. Never commit real values.
# Secrets only: every value in this file is treated as a secret and blanked out of anything the bot shows
# (a plain word here, such as a provider's name, would vanish from replies). Ordinary settings belong in
# core.yml or a module's config.yml (see "Not here" at the end).

# Discord: the main bot's token (Developer Portal → Bot → Reset Token; enable Message Content Intent).
DISCORD_BOT_TOKEN=

# Model providers: at least one. Candidates without a key are skipped.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=

# Optional: module keys.
WOLFRAM_APPID=                   # web: $wolfram

# Optional: drop-in plugins.
DISCORD_BOT_TOKEN_WHALE_CHAN=    # plugins/whale_chan: 鲸酱's own bot
WEBUI_PASSPHRASE=                # plugins/webui: asked once per browser (empty: anyone on the local network)

# Not here (they are settings, not secrets):
#   the owner's Discord ID   core.yml: owners: {discord: ["<your user ID>"]} (default: the application's owner)
#   a SearXNG instance       extensions/web/config.yml: searxng_url
#   yt-dlp cookies file      extensions/media/config.yml: cookies_file
#   WeChat database, keys    plugins/wechat/config.yml: database_root, database_keys
# The older variables for these (DISCORD_OWNER_ID, SEARXNG_URL, MEDIA_COOKIES_FILE, WECHAT_BRIDGE_DATABASE_ROOT,
# WECHAT_BRIDGE_DATABASE_KEYS) still work, but their values are then blanked out of replies like any other here.
