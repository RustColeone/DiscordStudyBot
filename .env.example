# Copy to .env (git-ignored) and fill in what you use. Never commit real values.

# Discord: the main bot's token (Developer Portal → Bot → Reset Token; enable Message Content Intent).
DISCORD_BOT_TOKEN=
# Optional: the bot owner's Discord user ID (default: the application's owner).
DISCORD_OWNER_ID=

# Model providers: at least one. Candidates without a key are skipped.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=

# Optional extension settings.
WOLFRAM_APPID=            # web: $wolfram
SEARXNG_URL=              # web: a SearXNG instance for search (otherwise Gemini grounding, then DuckDuckGo)
MEDIA_COOKIES_FILE=       # media: yt-dlp cookies file for sites that need a login

# Optional: WeChat (extensions/wechat; settings can also go in core.yml extension_config.wechat).
WECHAT_BRIDGE_DATABASE_ROOT=     # …/xwechat_files/wxid_…/db_storage
WECHAT_BRIDGE_DATABASE_KEYS=     # private key file from extensions.wechat.key_setup

# Optional: drop-in plugins (plugins/whale_chan: 鲸酱's own bot).
DISCORD_BOT_TOKEN_WHALE_CHAN=
