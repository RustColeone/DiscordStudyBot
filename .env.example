# Required. Enter the token directly on the server; never commit it.
TOKEN=

# Optional Discord IDs used by clock, broadcast, and music features.
ID_CHANNEL=
ID_CHANNEL1=
ID_MESSAGE=
ID_VOICECHANNEL=
DISCORD_ALLOWED_CHANNELS=
DISCORD_REQUIRE_MENTION=false
CREATOR_USER_ID=
CREATOR_ONLY_MODE=false
CREATOR_PROMPT=
TIMEZONE=America/Los_Angeles
# Optional regional label shown to the agent team; response language still follows the user.
AGENT_LOCALE=en-US
# Optional JSON object containing explicitly allowlisted MCP servers. Keep empty to disable MCP.
MCP_SERVERS_JSON=

# Native Linux WeChat account controlled from Discord. Owner defaults to CREATOR_USER_ID.
BRIDGE_DEFAULT=example
WECHAT_BRIDGE_OWNER_ID=
WECHAT_BRIDGE_DISPLAY=:0
WECHAT_BRIDGE_WAYLAND_DISPLAY=wayland-0
WECHAT_BRIDGE_PYTHON=/usr/bin/python3
WECHAT_BRIDGE_POLL_SECONDS=5
# Local per-file processing/upload budget; not a measured WeChat server limit.
WECHAT_BRIDGE_MAX_UPLOAD_MB=100
# deepseek or luna; blank model uses that character's configured model.
WECHAT_BRIDGE_REPLY_PROVIDER=deepseek
WECHAT_BRIDGE_REPLY_MODEL=
WECHAT_BRIDGE_COALESCE_SECONDS=1
WECHAT_BRIDGE_CATCHUP_SECONDS=900
WECHAT_BRIDGE_READ_BACKEND=desktop
WECHAT_BRIDGE_DATABASE_ROOT=
WECHAT_BRIDGE_DATABASE_KEYS=

# Optional integrations. Leave unset to keep those features disabled.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=
SERP_API_KEY=
WOLFRAM_APPID=
WOLFRAM_PATH=

# Independent image generation used by $draw. Gemini Nano Banana is the default.
DRAW_DEFAULT_PROVIDER=gemini
DRAW_GEMINI_MODEL=gemini-2.5-flash-image
DRAW_OPENAI_MODEL=gpt-image-2.5-sunburst
DRAW_OUTPUT_DIR=temp/generated_images
DRAW_OPENAI_OUTPUT_FORMAT=png
DRAW_OPENAI_QUALITY=auto
DRAW_OPENAI_SIZE=1024x1024

# Display-equation raster settings. Fixed width keeps Discord's visual scale consistent.
RICH_CONTENT_OUTPUT_DIR=temp/rendered_math
RICH_CONTENT_MATH_WIDTH_PX=1440
RICH_CONTENT_MATH_DPI=180
RICH_CONTENT_MATH_FONT_SIZE_PT=20
RICH_CONTENT_MATH_MIN_HEIGHT_PX=220

# Optional server-admin overrides for collaborative agent mode.
AGENT_DEEPSEEK_MODEL=deepseek-flash
AGENT_LUNA_MODEL=gpt-6-luna
AGENT_GEMINI_MODEL=gemini-3.8-flash
AGENT_GEMINI_FALLBACK_MODEL=gemini-3.6-flash
AGENT_CLAUDE_MODEL=claude-haiku-5-5
AGENT_GEMINI_MIN_INTERVAL_SECONDS=1.1

# Legacy planner/roleplay phase effort: low, medium, high, or max.
AGENT_ROUTING_EFFORT=low
# Shared room: low for initial turns, medium when inspecting results/dependencies.
# Set an effort here to override all room speakers.
AGENT_CONVERSATION_EFFORT=
AGENT_OPENING_EFFORT=high
AGENT_PLANNING_EFFORT=max
# Room limits count all characters, including approval/clarification resumes.
AGENT_WORK_MAX_STEPS=24
AGENT_WORK_MAX_ACTIONS=24

# Independent room discussion/consultation effort: low, medium, high, or max.
AGENT_DEEPSEEK_EFFORT=high
AGENT_LUNA_EFFORT=high
AGENT_GEMINI_EFFORT=high
AGENT_CLAUDE_EFFORT=high

# Optional OpenRouter migration. Keep a backend on direct to spend its existing
# provider balance; switch agents independently after setting a catalog model slug.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=DiscordStudyBot
AGENT_DEEPSEEK_BACKEND=direct
AGENT_LUNA_BACKEND=direct
AGENT_GEMINI_BACKEND=direct
AGENT_CLAUDE_BACKEND=direct
OPENROUTER_DEEPSEEK_MODEL=
OPENROUTER_LUNA_MODEL=
OPENROUTER_GEMINI_MODEL=
OPENROUTER_CLAUDE_MODEL=

# Use openrouter to enable its model-agnostic web plugin; direct keeps the
# existing SearXNG/DuckDuckGo/Google search pipeline. Failed requests fall back.
WEB_SEARCH_BACKEND=direct
OPENROUTER_WEB_SEARCH_MODEL=openrouter/auto
OPENROUTER_WEB_SEARCH_ENGINE=
OPENROUTER_WEB_SEARCH_MAX_RESULTS=5

ATTACHMENT_CACHE_DIR=temp/attachment_cache
AGENT_DEEPSEEK_PROMPT=
AGENT_LUNA_PROMPT=
AGENT_GEMINI_PROMPT=
AGENT_CLAUDE_PROMPT=
